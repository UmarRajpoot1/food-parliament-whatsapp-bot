# Copy this file to .env. Never commit .env or share these values.
PORT=3000

# Paste the permanent/system-user token from Meta Business settings here.
WHATSAPP_TOKEN=your_meta_whatsapp_cloud_api_token
# This is the visible testing number for reference; Meta API calls use the Phone Number ID below.
WHATSAPP_TEST_PHONE_NUMBER=+15551958936
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
# Paste the verify token you choose into Meta's webhook configuration too.
WHATSAPP_VERIFY_TOKEN=salonbot123secret

# Paste your Supabase project URL and server-side service key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# Paste your Groq API key here. OPENAI_API_KEY is optional; when set, it takes precedence.
GROQ_API_KEY=your_groq_api_key
# OPENAI_API_KEY=your_openai_api_key

# Choose any long random value and send it as x-admin-api-key.
ADMIN_API_KEY=your_admin_api_key

